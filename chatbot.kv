<Button>:
    size_hint_y: None
    height: 50

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10

        TextInput:
            id: username_input
            hint_text: "Username"
            multiline: False

        TextInput:
            id: password_input
            hint_text: "Password"
            password: True
            multiline: False

        Button:
            text: "Login"
            on_press: root.login()  # No need to pass 'self'

        Button:
            text: "Register"
            on_press: root.register()  # No need to pass 'self'

        Label:
            id: error_label
            text: ""
            color: (1, 0, 0, 1)

<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'

        ScrollView:
            BoxLayout:
                id: chat_history
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        TextInput:
            id: user_input
            size_hint_y: None
            height: 50
            multiline: False

        Button:
            text: "Send"
            size_hint_y: None
            height: 50
            on_press: root.send_message()
